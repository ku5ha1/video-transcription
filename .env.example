# Application Settings
APP_NAME=Video Transcription API
DEBUG=False
LOG_LEVEL=INFO

# Model Settings
DEVICE=cpu
MODEL_SIZE=tiny

# Whisper Settings
WHISPER_MODEL_ID=deepdml/faster-whisper-large-v3-turbo-ct2
WHISPER_COMPUTE_TYPE=int8
WHISPER_MODEL_CACHE_DIR=/app/models/whisper
WHISPER_LANGUAGE=

# Enhanced NLP Settings
EMOTION_MODEL_ID=Dpngtm/wav2vec2-emotion-recognition
EMOTION_MODEL_CACHE_DIR=/app/models/emotion
TONE_MODEL_ID=cross-encoder/nli-deberta-v3-small
TONE_MODEL_CACHE_DIR=/app/models/tone

# File Settings
MAX_FILE_SIZE=104857600
ALLOWED_VIDEO_EXTENSIONS=.mp4,.avi,.mov,.mkv,.webm

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@postgres:5432/transcription_db

# JWT Authentication
JWT_SECRET_KEY=your-secret-key-min-32-chars-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRATION_DAYS=7

# Redis
REDIS_URL=redis://redis:6379

# MinIO Object Storage
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=False

# Qdrant Vector Database
QDRANT_URL=http://qdrant:6333

# AssemblyAI (for speaker diarization fallback)
ASSEMBLYAI_API_KEY=***

# Hugging Face (for pyannote.audio and model downloads)
HUGGING_FACE_TOKEN=***